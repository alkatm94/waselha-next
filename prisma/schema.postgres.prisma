generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id             Int      @id @default(autoincrement())
  customerName   String?
  phone          String?
  productUrl     String
  productName    String?
  country        String
  currency       String
  productPrice   Float
  weightKg       Float
  serviceTier    String
  estimatedTotal Float
  status         String   @default("new")
  createdAt      DateTime @default(now())
}

model QuotePreset {
  id            Int      @id @default(autoincrement())
  country       String
  currency      String
  fxToSar       Float
  shippingPerKg Float
  serviceFee    Float
  createdAt     DateTime @default(now())
}

model Customer {
  id             Int               @id @default(autoincrement())
  customerId     String            @unique
  name           String
  email          String            @unique
  phone          String?
  passwordHash   String
  sessions       CustomerSession[]
  shipments      ChinaShipment[]
  purchaseOrders PurchaseOrder[]
  notifications  Notification[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model CustomerSession {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model WarehouseSetting {
  id             Int      @id @default(1)
  recipientName  String
  phone          String
  chineseAddress String
  englishAddress String
  city           String
  province       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ShipmentCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model PurchaseOrderCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model ChinaShipment {
  id                          Int                @id @default(autoincrement())
  internalReference           String             @unique
  customerId                  Int
  customerCode                String
  customer                    Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productName                 String
  productUrl                  String
  storeName                   String
  localTrackingNumber         String
  quantity                    Int
  productPrice                Float
  currency                    String
  invoiceImageUrl             String?
  notes                       String?
  status                      String             @default("REGISTERED")
  weightKg                    Float?
  lengthCm                    Float?
  widthCm                     Float?
  heightCm                    Float?
  actualWeightKg              Float?
  volumetricWeightKg          Float?
  chargeableWeightKg          Float?
  customerNote                String?
  internalNote                String?
  shippingFee                 Float?
  internationalTrackingNumber String?
  warehouseArrivedAt          DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  events                      ShipmentEvent[]
  photos                      ShipmentPhoto[]
  auditLogs                   ShipmentAuditLog[]
  notifications               Notification[]

  @@unique([customerId, localTrackingNumber])
  @@index([customerCode])
  @@index([localTrackingNumber])
  @@index([status])
}

model ShipmentEvent {
  id         Int           @id @default(autoincrement())
  shipmentId Int
  shipment   ChinaShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  note       String?
  createdAt  DateTime      @default(now())

  @@index([shipmentId])
}

model ShipmentPhoto {
  id         Int           @id @default(autoincrement())
  shipmentId Int
  shipment   ChinaShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  createdAt  DateTime      @default(now())

  @@index([shipmentId])
}

model AdminUser {
  id                     Int                     @id @default(autoincrement())
  name                   String
  email                  String                  @unique
  passwordHash           String
  role                   String                  @default("OPERATOR")
  sessions               AdminSession[]
  auditLogs              ShipmentAuditLog[]
  purchaseOrderAuditLogs PurchaseOrderAuditLog[]
  notifications          Notification[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model AdminSession {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  adminId   Int
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model ShipmentAuditLog {
  id            Int           @id @default(autoincrement())
  shipmentId    Int
  shipment      ChinaShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  adminId       Int?
  admin         AdminUser?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail    String
  field         String
  previousValue String?
  newValue      String?
  createdAt     DateTime      @default(now())

  @@index([shipmentId])
  @@index([adminId])
}

model PurchaseOrder {
  id                    Int                     @id @default(autoincrement())
  orderNumber           String                  @unique
  customerId            Int
  customer              Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerCode          String
  productUrl            String
  productName           String
  storeName             String
  variant               String?
  quantity              Int
  estimatedProductPrice Decimal?                @db.Decimal(12, 2)
  productImageUrl       String?
  notes                 String?
  status                String                  @default("PENDING_REVIEW")
  paymentStatus          String                  @default("UNPAID")
  paylinkTransactionNo   String?                 @unique
  paylinkPaymentUrl      String?
  paylinkOrderStatus     String?
  paidAmount             Decimal?                @db.Decimal(12, 2)
  paymentMethod          String?
  paymentReceiptUrl      String?
  paymentReceiptPasscode String?
  paymentCardLastFour    String?
  paymentCreatedAt       DateTime?
  paidAt                 DateTime?
  paymentFailureReason   String?
  paylinkQrUrl           String?
  paylinkMobileUrl       String?
  paylinkCheckUrl        String?
  quotedProductPrice    Decimal?                @db.Decimal(12, 2)
  domesticShipping      Decimal?                @db.Decimal(12, 2)
  serviceFee            Decimal?                @db.Decimal(12, 2)
  estimatedTaxes        Decimal?                @db.Decimal(12, 2)
  finalTotal            Decimal?                @db.Decimal(12, 2)
  customerNote          String?
  quotedAt              DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  auditLogs             PurchaseOrderAuditLog[]
  notifications         Notification[]

  @@index([customerId])
  @@index([customerCode])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model PurchaseOrderAuditLog {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  adminId         Int?
  admin           AdminUser?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail      String
  field           String
  previousValue   String?
  newValue        String?
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([adminId])
}


model StoreProduct {
  id                 Int      @id @default(autoincrement())
  storeName          String
  originalUrl        String
  externalProductId  String?
  arabicName         String
  originalName       String?
  description        String?
  priceJpy           Int?
  approxPriceSar     Decimal? @db.Decimal(12, 2)
  imageUrlsJson      String?
  category           String?
  brand              String?
  productCondition   String?
  availabilityStatus String   @default("HIDDEN")
  isFeatured         Boolean  @default(false)
  displayOrder       Int      @default(0)
  lastCheckedAt      DateTime?
  publishedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([storeName])
  @@index([availabilityStatus])
  @@index([isFeatured])
  @@index([displayOrder])
  @@index([createdAt])
}
model Notification {
  id              Int            @id @default(autoincrement())
  userId          Int?
  user            Customer?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserId     Int?
  adminUser       AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  shipmentId      Int?
  shipment        ChinaShipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  type            String
  title           String
  message         String
  isRead          Boolean        @default(false)
  readAt          DateTime?
  dedupeKey       String?        @unique
  createdAt       DateTime       @default(now())

  @@index([userId, isRead])
  @@index([adminUserId, isRead])
  @@index([shipmentId])
  @@index([purchaseOrderId])
  @@index([type])
}
