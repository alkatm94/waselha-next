PAYLINK_API_ID=
PAYLINK_SECRET_KEY=
# Production: https://restapi.paylink.sa - Testing: https://restpilot.paylink.sa
PAYLINK_BASE_URL="https://restpilot.paylink.sa"
PAYLINK_MODE="test"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
